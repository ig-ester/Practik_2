@page
@model Praktik.Pages.Documents.IndexModel
@{
    ViewData["Title"] = "Документы движения";
}

<div class="row g-4">
    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
    {
        <div class="col-md-6 col-xl-3">
            <div class="card card-doc h-100">
                <div class="card-body text-center p-4">
                    <div class="icon-wrapper bg-success bg-opacity-10 rounded-circle mb-3 mx-auto">
                        <i class="bi bi-box-arrow-in-down text-success"></i>
                    </div>
                    <h5 class="card-title">Приёмка товара</h5>
                    <p class="text-muted small mb-3">Поступление от поставщиков</p>
                    <a asp-page="Receiving/Create" class="btn btn-success">
                        <i class="bi bi-plus-lg me-2"></i>Создать
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card card-doc h-100">
                <div class="card-body text-center p-4">
                    <div class="icon-wrapper bg-info bg-opacity-10 rounded-circle mb-3 mx-auto">
                        <i class="bi bi-box-arrow-in-up text-info"></i>
                    </div>
                    <h5 class="card-title">Оприходование</h5>
                    <p class="text-muted small mb-3">Внутреннее поступление</p>
                    <a asp-page="Posting/Create" class="btn btn-info text-white">
                        <i class="bi bi-plus-lg me-2"></i>Создать
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card card-doc h-100">
                <div class="card-body text-center p-4">
                    <div class="icon-wrapper bg-warning bg-opacity-10 rounded-circle mb-3 mx-auto">
                        <i class="bi bi-clipboard-check text-warning"></i>
                    </div>
                    <h5 class="card-title">Инвентаризация</h5>
                    <p class="text-muted small mb-3">Проверка остатков</p>
                    <a asp-page="Inventory/Create" class="btn btn-warning">
                        <i class="bi bi-plus-lg me-2"></i>Создать
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card card-doc h-100">
                <div class="card-body text-center p-4">
                    <div class="icon-wrapper bg-danger bg-opacity-10 rounded-circle mb-3 mx-auto">
                        <i class="bi bi-trash text-danger"></i>
                    </div>
                    <h5 class="card-title">Списание</h5>
                    <p class="text-muted small mb-3">Списание товаров</p>
                    <a asp-page="WriteOff/Create" class="btn btn-danger">
                        <i class="bi bi-plus-lg me-2"></i>Создать
                    </a>
                </div>
            </div>
        </div>
    }

    @if (User.IsInRole("Cashier") || User.IsInRole("Manager") || User.IsInRole("Admin"))
    {
        <div class="col-md-6 col-xl-3">
            <div class="card card-doc h-100">
                <div class="card-body text-center p-4">
                    <div class="icon-wrapper bg-primary bg-opacity-10 rounded-circle mb-3 mx-auto">
                        <i class="bi bi-cart-check text-primary"></i>
                    </div>
                    <h5 class="card-title">Розничная продажа</h5>
                    <p class="text-muted small mb-3">Продажа через кассу</p>
                    <a asp-page="Sales/Retail" class="btn btn-primary">
                        <i class="bi bi-cart-plus me-2"></i>Открыть
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card card-doc h-100">
                <div class="card-body text-center p-4">
                    <div class="icon-wrapper bg-secondary bg-opacity-10 rounded-circle mb-3 mx-auto">
                        <i class="bi bi-cart-check text-primary"></i>
                    </div>
                    <h5 class="card-title">Оптовая продажа</h5>
                    <p class="text-muted small mb-3">Оптовая реализация</p>
                    <a asp-page="Sales/Wholesale" class="btn btn-secondary text-white">
                        <i class="bi bi-box me-2"></i>Открыть
                    </a>
                </div>
            </div>
        </div>
    }

    <div class="col-md-6 col-xl-3">
        <div class="card card-doc h-100">
            <div class="card-body text-center p-4">
                <div class="icon-wrapper bg-dark bg-opacity-10 rounded-circle mb-3 mx-auto">
                    <i class="bi bi-bar-chart-line text-dark"></i>
                </div>
                <h5 class="card-title">Отчёт по остаткам</h5>
                <p class="text-muted small mb-3">Анализ складских остатков</p>
                <a asp-page="/Reports/Stock" class="btn btn-dark">
                    <i class="bi bi-eye me-2"></i>Просмотр
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .icon-wrapper {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-wrapper i {
        font-size: 24px;
    }

    .card-doc {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card-doc:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }
</style>