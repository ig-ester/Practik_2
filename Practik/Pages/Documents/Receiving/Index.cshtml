@page
@model Praktik.Pages.Documents.Receiving.IndexModel
@{
    ViewData["Title"] = "Приёмка товара";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-box-arrow-in-down me-2"></i>Приёмка товара</h2>
    <a asp-page="Create" class="btn btn-success">
        <i class="bi bi-plus-lg me-2"></i>Создать приёмку
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <input type="text" name="searchTerm" class="form-control"
                       placeholder="Поиск по номеру документа" value="@Model.SearchTerm">
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">Все статусы</option>
                    <option value="Draft" selected="@(Model.StatusFilter == "Draft")">Черновик</option>
                    <option value="Final" selected="@(Model.StatusFilter == "Final")">Проведён</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Отменён</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i>Найти
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Documents.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>№ документа</th>
                            <th>Дата создания</th>
                            <th>Склад</th>
                            <th>Контрагент</th>
                            <th>Позиций</th>
                            <th>Сумма</th>
                            <th>Статус</th>
                            <th>Создал</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model.Documents)
                        {
                            <tr>
                                <td><strong>@doc.Number</strong></td>
                                <td>@doc.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@doc.Warehouse</td>
                                <td>@(doc.Contractor ?? "-")</td>
                                <td>@doc.ItemsCount</td>
                                <td>@doc.TotalAmount.ToString("C")</td>
                                <td>
                                    @if (doc.Status == "Final")
                                    {
                                        <span class="badge bg-success">Проведён</span>
                                    }
                                    else if (doc.Status == "Draft")
                                    {
                                        <span class="badge bg-warning">Черновик</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Отменён</span>
                                    }
                                </td>
                                <td>@doc.CreatedBy</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-page="Details" asp-route-id="@doc.Id"
                                           class="btn btn-outline-primary" title="Просмотр">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-page="Edit" asp-route-id="@doc.Id"
                                           class="btn btn-outline-info" title="Редактировать">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (doc.Status == "Draft")
                                        {
                                            <form method="post" asp-page-handler="Delete"
                                                  asp-route-id="@doc.Id" class="d-inline"
                                                  onsubmit="return confirm('Удалить документ?');">
                                                <button type="submit" class="btn btn-outline-danger" title="Удалить">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mb-0 mt-2">Документы приёмки не найдены</p>
            </div>
        }
    </div>
</div>