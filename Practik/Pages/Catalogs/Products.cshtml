@page
@model Praktik.Pages.Catalogs.ProductsModel
@{
    ViewData["Title"] = "Номенклатура";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Номенклатура товаров</h2>
    <a asp-page="ProductEdit" class="btn btn-primary">+ Добавить товар</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Наименование</th>
            <th>Категория</th>
            <th>Цена (Розн)</th>
            <th>Маркировка</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Products)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.Category</td>
                <td>@p.PriceRetail.ToString("C")</td>
                <td>@(p.IsMarked ? "DataMatrix" : "-")</td>
                <td>
                    <a asp-page="ProductEdit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">✏️</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id" class="d-inline" onsubmit="return confirm('Удалить?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger">🗑️</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>