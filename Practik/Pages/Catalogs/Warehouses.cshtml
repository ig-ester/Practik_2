@page
@model Praktik.Pages.Catalogs.WarehousesModel
@{
    ViewData["Title"] = "Склады";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-building me-2"></i>Склады</h2>
    <a asp-page="WarehouseEdit" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>Добавить склад
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Warehouses.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Название</th>
                            <th>Тип</th>
                            <th>Организация</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var warehouse in Model.Warehouses)
                        {
                            <tr>
                                <td><strong>@warehouse.Name</strong></td>
                                <td>
                                    @if (warehouse.Type == "Склад")
                                    {
                                        <span class="badge bg-secondary">Склад</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Магазин</span>
                                    }
                                </td>
                                <td>@warehouse.Organization.Name</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-page="WarehouseEdit" asp-route-id="@warehouse.Id"
                                           class="btn btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" asp-page-handler="Delete"
                                              asp-route-id="@warehouse.Id" class="d-inline"
                                              onsubmit="return confirm('Удалить склад?');">
                                            <button type="submit" class="btn btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mb-0 mt-2">Склады не созданы</p>
            </div>
        }
    </div>
</div>