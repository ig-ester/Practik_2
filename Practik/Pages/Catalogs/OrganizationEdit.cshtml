@page "{id:int?}"
@model Praktik.Pages.Catalogs.OrganizationEditModel
@{
    ViewData["Title"] = Model.Organization.Id == 0 ? "Новая организация" : "Редактирование организации";
}

<h2><i class="bi bi-building me-2"></i>@ViewData["Title"]</h2>

<form method="post" class="mt-4">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Organization.Id" />

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Organization.Name" class="form-label">Наименование организации *</label>
                        <input asp-for="Organization.Name" class="form-control" required placeholder="Например: ООО «Аптека Здоровье»" />
                        <span asp-validation-for="Organization.Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Organization.Address" class="form-label">Юридический адрес</label>
                        <input asp-for="Organization.Address" class="form-control" placeholder="г. Москва, ул. Примерная, д. 1" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-2"></i>Сохранить
                </button>
                <a asp-page="Organizations" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-2"></i>Отмена
                </a>
            </div>

            @if (Model.Organization.Id > 0)
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <h6 class="card-title">Информация</h6>
                        <p class="mb-1"><strong>Создана:</strong> @Model.Organization.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                        <p class="mb-0"><strong>ID в системе:</strong> @Model.Organization.Id</p>
                    </div>
                </div>
            }
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}