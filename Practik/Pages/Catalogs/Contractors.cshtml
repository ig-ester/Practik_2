@page
@model Praktik.Pages.Catalogs.ContractorsModel
@{
    ViewData["Title"] = "Контрагенты";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people me-2"></i>Контрагенты</h2>
    <a asp-page="ContractorEdit" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>Добавить контрагента
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <input type="text" name="searchTerm" class="form-control"
                       placeholder="Поиск по названию или ИНН" value="@Model.SearchTerm">
            </div>
            <div class="col-md-4">
                <select name="type" class="form-select">
                    <option value="">Все типы</option>
                    <option value="Supplier" selected="@(Model.TypeFilter == "Supplier")">Поставщик</option>
                    <option value="Buyer" selected="@(Model.TypeFilter == "Buyer")">Покупатель</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i>Найти
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Contractors.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Наименование</th>
                            <th>Тип</th>
                            <th>ИНН</th>
                            <th>Адрес</th>
                            <th>Контакты</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contractor in Model.Contractors)
                        {
                            <tr>
                                <td><strong>@contractor.Name</strong></td>
                                <td>
                                    @if (contractor.Type == "Supplier")
                                    {
                                        <span class="badge bg-success">Поставщик</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">Покупатель</span>
                                    }
                                </td>
                                <td>@(contractor.INN ?? "-")</td>
                                <td>@(contractor.Address ?? "-")</td>
                                <td>@(contractor.ContactInfo ?? "-")</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-page="ContractorEdit" asp-route-id="@contractor.Id"
                                           class="btn btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" asp-page-handler="Delete"
                                              asp-route-id="@contractor.Id" class="d-inline"
                                              onsubmit="return confirm('Удалить контрагента?');">
                                            <button type="submit" class="btn btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mb-0 mt-2">Контрагенты не найдены</p>
            </div>
        }
    </div>
</div>