@page
@model Praktik.Pages.Catalogs.UsersModel
@{
    ViewData["Title"] = "Пользователи";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person-badge me-2"></i>Пользователи</h2>
    <a asp-page="UserEdit" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>Добавить пользователя
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Users.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Логин</th>
                            <th>Роль</th>
                            <th>Организация</th>
                            <th>Последний вход</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td><strong>@user.Login</strong></td>
                                <td>
                                    @if (user.Role?.Name == "Admin")
                                    {
                                        <span class="badge bg-danger">Администратор</span>
                                    }
                                    else if (user.Role?.Name == "Manager")
                                    {
                                        <span class="badge bg-primary">Управляющий</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Кассир</span>
                                    }
                                </td>
                                <td>@user.Organization.Name</td>
                                <td>
                                    @(user.LastLogin?.ToString("dd.MM.yyyy HH:mm") ?? "Никогда")
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Активен</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Заблокирован</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-page="UserEdit" asp-route-id="@user.Id"
                                           class="btn btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" asp-page-handler="ToggleActive"
                                              asp-route-id="@user.Id" class="d-inline">
                                            <button type="submit" class="btn @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                                <i class="bi @(user.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mb-0 mt-2">Пользователи не найдены</p>
            </div>
        }
    </div>
</div>