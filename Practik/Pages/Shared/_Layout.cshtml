<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Praktik</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="wrapper">
            <nav id="sidebar" class="sidebar">
                <div class="sidebar-header">
                    <div class="logo">
                        
                        @* <i class="bi bi-capsule-pill"></i> *@
                        <span>Praktik</span>
                    </div>
                    <p class="text-muted small mb-0">Система учёта препаратов</p>
                </div>

                <ul class="nav-components">
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Documents/Index">
                                <i class="bi bi-file-earmark-text"></i>
                                <span>Документы</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Documents/Receiving/Create">
                                <i class="bi bi-box-arrow-in-down"></i>
                                <span>Приёмка</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Documents/Posting/Create">
                                <i class="bi bi-box-arrow-in-up"></i>
                                <span>Оприходование</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Documents/Inventory/Create">
                                <i class="bi bi-clipboard-check"></i>
                                <span>Инвентаризация</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Documents/WriteOff/Create">
                                <i class="bi bi-trash"></i>
                                <span>Списание</span>
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Cashier") || User.IsInRole("Manager") || User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Documents/Sales/Retail">
                                <i class="bi bi-cart-check"></i>
                                <span>Розничная продажа</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Documents/Sales/Wholesale">
                                <i class="bi bi-box-seam"></i>
                                <span>Оптовая продажа</span>
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Reports/Stock">
                            <i class="bi bi-bar-chart-line"></i>
                            <span>Отчёт по остаткам</span>
                        </a>
                    </li>

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-divider">Справочники</li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Catalogs/Products">
                                <i class="bi bi-list-ul"></i>
                                <span>Номенклатура</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Catalogs/Contractors">
                                <i class="bi bi-people"></i>
                                <span>Контрагенты</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Catalogs/Organizations">
                                <i class="bi bi-building"></i>
                                <span>Организации</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Catalogs/Warehouses">
                                <i class="bi bi-building"></i>
                                <span>Склады</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Catalogs/Users">
                                <i class="bi bi-person-badge"></i>
                                <span>Пользователи</span>
                            </a>
                        </li>
                    }
                </ul>

                <div class="sidebar-footer">
                    <form method="post" asp-page="/Account/Logout" class="d-inline">
                        <button type="submit" class="btn btn-logout w-100">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Выйти</span>
                        </button>
                    </form>
                </div>
            </nav>

            <div id="content" class="content">
                <header class="top-navbar">
                    <div class="navbar-left">
                        <button type="button" id="sidebarCollapse" class="btn btn-menu-toggle d-lg-none">
                            <i class="bi bi-list"></i>
                        </button>
                        <h4 class="mb-0">@ViewData["Title"]</h4>
                    </div>
                    <div class="navbar-right">
                        <div class="user-info">
                            <i class="bi bi-person-circle"></i>
                            <div class="user-details">
                                <span class="user-name">@User.Identity.Name</span>
                                <span class="user-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                            </div>
                        </div>
                    </div>
                </header>

                <main class="main-content">
                    <div class="container-fluid">
                        @RenderBody()
                    </div>
                </main>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>